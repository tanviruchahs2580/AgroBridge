# ============================================================
# AgroBridge environment template
# Copy to .env (development) or configure per environment.
# NEVER commit a real .env with production credentials.
# ============================================================

# --- Core ---
NODE_ENV=development
PORT=4000
# The API's own public origin, when it must be stable behind a proxy
# (payment-gateway return URLs). Optional locally; `API_BASE_URL` was never read
# by any code — the name existed only here and misled whoever set it.
# API_PUBLIC_URL=https://api.example.com
# Comma-separated CORS/redirect allow-list. In production, plain-http localhost
# entries are DROPPED automatically (a dev origin on a live allow-list lets any
# locally-served page call the API); "https://localhost" is always kept because
# it is the Capacitor WebView origin of the Android build.
WEB_ORIGIN=http://localhost:5173
# Dev-only escape hatch that re-admits http://localhost origins in production —
# used solely by the local docker stack (NODE_ENV=production there). Never set
# on a real deployment.
# ALLOW_DEV_ORIGINS=1

# --- Database ---
# Development/test uses SQLite (file). Production should use PostgreSQL:
#   provider in apps/api/prisma/schema.prisma -> "postgresql"
#   DATABASE_URL="postgresql://user:pass@host:5432/agrobridge?schema=public"
DATABASE_URL="file:./prisma/dev.db"
# Prisma pool size for THIS instance (PostgreSQL only; the SQLite profile is
# untouched). Unset keeps Prisma's default of cpus*2+1 — which was 9 connections
# on the machine audited for the 10k-concurrency report. Size it so that
# (instances x limit) stays inside the database's own max_connections; Neon's
# pooler endpoint has its own ceiling.
# DATABASE_CONNECTION_LIMIT=20
# Seconds a request may wait for a free connection before failing (Prisma
# default 10). On expiry the API answers 503 + Retry-After, not a bare 500.
# DATABASE_POOL_TIMEOUT_SECONDS=10

# --- Auth ---
JWT_ACCESS_SECRET=change-me-to-a-64-char-random-string-in-production
JWT_REFRESH_SECRET=change-me-to-another-64-char-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Worker threads used for bcrypt hashing. Unset selects min(4, cores - 1).
# bcryptjs is pure JavaScript, so without the pool a login burst pins the event
# loop: measured 100 simultaneous logins took 77 s and an unrelated /health
# request waited 74 s. 0 restores that pre-fix behaviour (event-loop hashing).
# BCRYPT_POOL_SIZE=4

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
# Global budget per 15-minute window. Keyed per signed-in credential and per
# address otherwise, so a carrier-NAT address is not one shared quota (F-04).
RATE_LIMIT_MAX=300
# Login attempts per window per ACCOUNT (keyed by the phone in the body), not
# per address — one NAT neighbour can no longer spend another user's budget. A
# browser test suite signs in far more often than a person; raise it only for
# throwaway instances.
LOGIN_RATE_LIMIT_MAX=20
# Account creations per window per ADDRESS. Deliberately address-keyed even
# after F-04: it is the mass-registration control and the key would otherwise be
# attacker-supplied. Raise it where a large shared address is legitimate.
REGISTER_RATE_LIMIT_MAX=10
# Requests this instance will work on at once; beyond it the API answers
# 503 + Retry-After rather than queueing without bound (F-05). 0 disables it.
# Size it near what one instance actually sustains: measured on the audited box,
# a ceiling of 24 gave p50 385 ms and 2.4x fewer timeouts than no guard, while a
# ceiling of 256 changed nothing at all (the excess queues in the socket accept
# backlog, out of reach of any middleware).
MAX_CONCURRENT_REQUESTS=128

# --- HTTP server timeouts (milliseconds) ---
# Node's defaults are 300 s for a whole request and 60 s for headers, so a stalled
# request could be held longer than any client waits. Shortened to fail first.
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=20000
# Idle keep-alive lifetime. Unset keeps Node's 5 s, the safe ordering in front of
# a 60 s load-balancer idle timeout (server closes idle sockets before the
# balancer reuses them). Set it only when the balancer closes first — then keep it
# above that idle timeout AND raise HEADERS_TIMEOUT_MS above it.
# KEEPALIVE_TIMEOUT_MS=65000
# Cap on simultaneous open connections (Node's default: unlimited). At 10 000
# concurrent sessions the audit found excess demand piling up in the socket accept
# backlog invisible to the in-process guard, so a connection-level cap at the edge
# (balancer/CDN first, here as a backstop) is what turns a flood into a fast
# refusal. Set it well above legitimate concurrency, sized with the proxy in front.
# SERVER_MAX_CONNECTIONS=5000

# --- Weather provider (optional; falls back to deterministic mock) ---
WEATHER_PROVIDER=mock            # mock | openweather
OPENWEATHER_API_KEY=
# Reuse a successful fetch this many seconds, keyed by rounded location.
# 0 disables the cache. Provider failures are never served from cache.
WEATHER_CACHE_TTL_SECONDS=600

# --- AI provider (optional; falls back to grounded offline KB engine) ---
AI_PROVIDER=offline              # offline | openai-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_MONTHLY_BUDGET_PAISA=500000
# Advisory requests per hour PER USER (keyed by account, not by address — a
# carrier-NAT address is thousands of users). Fleet-wide ceiling is therefore
# (active users x this); the monthly budget above guards the spend.
AI_HOURLY_LIMIT=30
# REQUIRED (> 0) when AI_PROVIDER=openai-compatible in production: the monthly
# spend breaker multiplies usage by this price, so 0 makes the guard inert and
# production startup refuses to boot (A7-05). Set the provider's real
# per-1K-token price in paisa.
AI_COST_PER_1K_TOKENS_PAISA=0

# --- Payment provider (sandbox only until real credentials provided) ---
PAYMENT_PROVIDER=sandbox         # sandbox | sslcommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# A production deployment with the sandbox provider REFUSES to complete a
# simulated payment unless this is explicitly set to 1 (pilots/demos only).
# Never enable it for a real launch: reporting an unpaid order as paid is
# deceptive, and Play treats it as such.
# ALLOW_SANDBOX_PAYMENTS_IN_PRODUCTION=1

# Public base URL of this API (no trailing /api/v1), used for payment-gateway
# return URLs. Required in practice once a live gateway is configured.
# API_PUBLIC_URL=https://api.example.com

# --- SMS/notification provider (in-app always on; sms optional) ---
SMS_PROVIDER=sandbox             # sandbox | none | http
# SMS_PROVIDER=http posts { to, text } (+ sender id / bearer key) to this
# gateway. Required with SMS_PROVIDER=http in production, so real OTPs can be
# delivered without a code change.
# SMS_API_URL=https://sms-gateway.example.com/send
# SMS_API_KEY=
# SMS_SENDER_ID=AgroBridge
# Production boot with placeholder providers (SMS sandbox/none, WEATHER mock,
# AI offline) requires explicit operator sign-off; without it startup aborts.
# ALLOW_PLACEHOLDER_PROVIDERS=1

# --- Storage provider (local FS default; db or s3 for production) ---
# db stores uploads in the database (durable, no external service — ADR-0012);
# s3 needs the bucket credentials below; local loses uploads on redeploy and is
# rejected by the production release gate (deploy-verify.yml).
STORAGE_PROVIDER=local           # local | s3 | db
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Web-only build inputs (not read by the API) ---
# Absolute API base compiled into the web bundle / APK.
# VITE_API_BASE_URL https://api.example.com/api/v1
# Feature switches read by the web bundle (set to "false" to disable):
#   VITE_FEATURE_NEW_SHELL    — dead-code-eliminates the legacy shell
#   VITE_FEATURE_ONBOARDING   — skips the onboarding flow
VITE_FEATURE_NEW_SHELL=true
VITE_FEATURE_ONBOARDING=true

# Uploaded files (disease photos) are stored under this base directory when
# STORAGE_PROVIDER=local. Default: <api cwd>/uploads.
# UPLOAD_BASE_DIR=

# --- Observability ---
# Prometheus metrics exposed at /metrics (private-network or METRICS_TOKEN in production)
#METRICS_TOKEN=change-me-metrics-token
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info

# --- Android / PWA build ---
# Absolute API base for Capacitor APK builds and cross-origin deployments.
# Leave empty when the web bundle is served behind the same-origin nginx /api proxy.
VITE_API_BASE_URL=
# Example (APK): VITE_API_BASE_URL=https://api.agro.example.com/api/v1
# When serving the APK, also add "https://localhost" (Capacitor origin) to WEB_ORIGIN.

# --- Hardening / scale (v1.5) ---
# Number of trusted proxy hops in front of the API (nginx=1; "false" disables).
TRUST_PROXY=1
# Shared rate-limit windows across pods. Leave empty for single instance.
REDIS_URL=
# AI spend guard: monthly soft budget + cost model.
AI_MONTHLY_BUDGET_PAISA=50000
AI_COST_PER_1K_TOKENS_PAISA=0

# --- Object storage (production uploads) ---
# S3_ENDPOINT empty = AWS virtual-hosted style; set for R2/MinIO.
S3_ENDPOINT=