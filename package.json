{
  "name": "agrobridge",
  "version": "1.4.1",
  "private": true,
  "description": "AgroBridge — Integrated Digital Agriculture Platform (Green Soil. Smart Farm. Secure Future.)",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/generate-prisma.mjs",
    "dev": "npm run dev --workspace apps/api & npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "test": "npm run test --workspace apps/api",
    "typecheck": "npm run typecheck --workspace apps/api && npm run typecheck --workspace apps/web",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "qa:knip": "knip --no-progress --no-config-hints",
    "qa:jscpd": "jscpd",
    "qa:licenses": "node scripts/qa/check-licenses.mjs",
    "qa:versioncode": "node scripts/qa/check-versioncode.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "deepmerge-ts": "^8.0.0",
    "source-map-js": "^1.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "jscpd": "^5.4.1",
    "knip": "^6.42.0",
    "prisma": "^6.5.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "prisma@6.19.3": true
  }
}
