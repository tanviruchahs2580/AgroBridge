{
  "ci": {
    "collect": { "url": ["http://localhost:4173/"], "startServerCommand": "npm run preview -- --port 4173", "numberOfRuns": 3 },
    "assert": { "assertions": { "categories:performance": ["warn", {"minScore": 0.85}], "categories:accessibility": ["error", {"minScore": 0.95}], "categories:best-practices": ["warn", {"minScore": 0.9}] } },
    "upload": { "target": "temporary-public-storage" }
  }
}
