<?xml version="1.0" encoding="utf-8"?>
<!--
  Release network policy: HTTPS only.

  Cleartext HTTP is refused everywhere, including loopback, so a shipped build
  cannot be downgraded to plaintext. The development exceptions live in
  src/debug/res/xml/network_security_config.xml, which overrides this file for
  debug builds only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
