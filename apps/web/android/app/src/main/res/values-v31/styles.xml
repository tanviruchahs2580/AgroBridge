<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) launch splash. The platform reads ONLY the
         android:* attributes below; the library-prefixed attrs in
         values/styles.xml are ignored on 31+. Leaving these unset made
         devices show the OEM default splash background (observed: sage on
         HyperOS) with the launcher icon before the branded in-app splash —
         the extra pre-launch screen reported from the field. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
