<?xml version="1.0" encoding="utf-8"?>
<!-- Launch-splash icon: the in-app splash's logo group reproduced at the same dp
     sizes, so the platform launch screen and src/components/Splash.tsx show the
     same thing on the same backdrop — the hand-over has nothing to cut to.
     Artwork: 120dp ring track, 64dp white disc, 56dp rounded logo tile.

     Generated by scripts/android-splash-icon.py; do not hand-edit the bitmaps.

     Each bitmap is 288dp in *pixels* at its density, so its intrinsic size is
     exactly the 288dp box Android 12+ draws the splash icon into (and the box the
     compat theme's layer-list names on API 24-30). Drawn at intrinsic size or
     scaled to fill that box, the mark lands at its authored size either way.
     The previous 108dp inset-of-a-bitmap was not authored to the box: it was
     scaled up 288/108 and put a ~176dp emblem on screen where the in-app splash
     then drew its 64dp mark — the second, differently-branded screen the field
     reported before the splash animation. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/splash_logo"
    android:gravity="fill" />
