<?xml version="1.0" encoding="utf-8"?>
<!-- Launch-splash icon mirroring the in-app Splash: white disc + green
     sprout (stem, seed, two leaves) on the deep-green background.
     Artwork stays inside the 66dp safe-zone circle of the 108dp canvas so
     the platform circular mask never clips it (Android 12+ splash spec). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- White disc (66dp safe zone, centered) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,21a33,33 0 1,0 0,66a33,33 0 1,0 0,-66z"/>
    <!-- Stem — rounded bottom, brand green -->
    <path
        android:fillColor="#15803D"
        android:pathData="M52.4,46.5h3.2v12.6a1.6,1.6 0 0,1 -3.2,0z"/>
    <!-- Seed base -->
    <path
        android:fillColor="#14532D"
        android:pathData="M52.1,59.4a1.9,1.9 0 1,0 3.8,0a1.9,1.9 0 1,0 -3.8,0z"/>
    <!-- Left leaf -->
    <group
        android:rotation="-32"
        android:pivotX="47.4"
        android:pivotY="44.6">
        <path
            android:fillColor="#4ADE80"
            android:pathData="M40.9,44.6a6.5,4.4 0 1,0 13,0a6.5,4.4 0 1,0 -13,0z"/>
    </group>
    <!-- Right leaf -->
    <group
        android:rotation="32"
        android:pivotX="60.6"
        android:pivotY="44.6">
        <path
            android:fillColor="#22C55E"
            android:pathData="M54.1,44.6a6.5,4.4 0 1,0 13,0a6.5,4.4 0 1,0 -13,0z"/>
    </group>
</vector>
