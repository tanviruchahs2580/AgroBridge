generator client {
  provider = "prisma-client-js"
  // rhel-openssl-3.0.x — Vercel Node runtime (Amazon Linux 2023); native — local dev/CI.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite connector used for development/test reproducibility.
// For production PostgreSQL: change provider to "postgresql" and set DATABASE_URL.
// String fields with validated values replace native enums (SQLite limitation).

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  fullName     String
  role         String   @default("FARMER") // SUPER_ADMIN|ADMIN|REGIONAL_MANAGER|AREA_MANAGER|FIELD_AGENT|COLLECTION_MANAGER|WAREHOUSE_MANAGER|PROCUREMENT_MANAGER|SERVICE_PROVIDER|DEALER|CORPORATE|COOPERATIVE|FARMER
  langPref     String   @default("bn") // bn|en
  status       String   @default("ACTIVE") // ACTIVE|SUSPENDED|DISABLED
  region       String? // territory scope for manager roles (e.g., DHAKA_NORTH)
  phoneVerified Boolean @default(false)
  notificationPrefs String? // JSON {critical:boolean,action:boolean,info:boolean}
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  withdrawals       Withdrawal[]
  otpChallenges     OtpChallenge[]
  analyticsEvents   AnalyticsEvent[]
  refreshTokens     RefreshToken[]
  farmerProfile     FarmerProfile?
  farms             Farm[]
  cart              Cart?
  orders            Order[]
  bookings          Booking[]
  procurementOrders ProcurementOrder[]
  payments          Payment[]
  wallet            Wallet?
  notifications     Notification[]
  advisoryQueries   AdvisoryQuery[]
  diseaseCases      DiseaseCase[]
  auditLogs         AuditLog[]
  aiUsageLogs       AiUsageLog[]
  organizationMembers OrganizationMember[]

  // Territory scoping (procurement queue/review, booking assignment, wallet
  // payouts): those queries filter or assert on user.region via the relation.
  @@index([region])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceInfo String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FarmerProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  nidLast4       String?
  address        String?
  district       String?
  upazila        String?
  membershipTier String    @default("BRONZE") // BRONZE|SILVER|GOLD
  membershipExpiresAt DateTime?
  joinedAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Farm {
  id            String   @id @default(cuid())
  ownerId       String
  organizationId String?
  name          String
  address       String?
  district      String?
  upazila       String?
  lat           Float?
  lng           Float?
  totalAreaBigha Float?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organization  Organization? @relation(fields: [organizationId], references: [id])
  plots         Plot[]
  bookings      Booking[]
  procurementOrders ProcurementOrder[]
  farmEvents    FarmEvent[]

  @@index([ownerId])
  @@index([organizationId])
}

model Plot {
  id            String   @id @default(cuid())
  farmId        String
  name          String
  areaBigha     Float
  soilType      String?
  irrigationType String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropCycles    CropCycle[]
  farmEvents    FarmEvent[]

  @@index([farmId])
}

model CropCycle {
  id                 String    @id @default(cuid())
  plotId             String
  cropName           String
  variety            String?
  plantedAt          DateTime
  expectedHarvestAt  DateTime?
  stage              String    @default("SEED") // SEED|GERMINATION|VEGETATIVE|FLOWERING|GRAIN_FRUIT_DEVELOPMENT|HARVEST
  status             String    @default("ACTIVE") // ACTIVE|HARVESTED|FAILED
  yieldKg            Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  plot               Plot      @relation(fields: [plotId], references: [id], onDelete: Cascade)
  farmEvents         FarmEvent[]
  diseaseCases       DiseaseCase[]

  @@index([plotId])
  @@index([status])
}

model FarmEvent {
  id          String   @id @default(cuid())
  clientUuid  String?  @unique // offline sync idempotency
  farmId      String
  plotId      String?
  cropCycleId String?
  actorId     String
  type        String // PLANTING|SEED|FERTILIZER|IRRIGATION|PEST|DISEASE|SERVICE|HARVEST|OTHER
  title       String
  notes       String?
  metadataStr String? // JSON-serialized metadata (validated at API layer)
  occurredAt  DateTime
  source      String   @default("APP") // APP|SYNC|ADMIN
  createdAt   DateTime @default(now())
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plot        Plot?    @relation(fields: [plotId], references: [id])
  cropCycle   CropCycle? @relation(fields: [cropCycleId], references: [id])

  @@index([farmId])
  // Farm timeline paging: filter by farm, order by occurredAt desc, take N
  // (farms/routes.ts getEventsHandler) — [farmId] alone forces a sort.
  @@index([farmId, occurredAt])
  @@index([cropCycleId])
}

model AdvisoryQuery {
  id                String   @id @default(cuid())
  userId            String
  question          String
  answer            String
  confidence        Float
  provider          String
  model             String
  lowConfidenceFlag Boolean  @default(false)
  groundedRefs      String? // JSON array of KB refs
  feedbackReason    String? // farmer feedback: why the answer was not useful (A7-07)
  feedbackAt        DateTime? // when the feedback was submitted (A7-07)
  createdAt         DateTime @default(now())
  kbVersion         String? // KB corpus version(s) that grounded this answer
  promptVersion     String? // hosted prompt-template version, when applicable
  requestId         String? // request correlation id (X-Request-Id)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DiseaseCase {
  id             String    @id @default(cuid())
  userId         String
  cropCycleId    String?
  imagePath      String
  cropGuess      String?
  diagnosis      String?
  confidence     Float?
  severity       String? // LOW|MODERATE|HIGH
  recommendation String?
  status         String    @default("PENDING_REVIEW") // AI_ONLY|PENDING_REVIEW|REVIEWED
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropCycle      CropCycle? @relation(fields: [cropCycleId], references: [id])

  @@index([userId])
  @@index([status])
}

model Product {
  id            String    @id @default(cuid())
  sku           String    @unique
  name          String
  category      String // SEED|FERTILIZER|BIO_INPUT|CROP_PROTECTION|EQUIPMENT
  description   String?
  unit          String    @default("KG")
  pricePaisa    Int
  stockQty      Int       @default(0)
  batchNo       String?
  expiryDate    DateTime?
  supplier      String?
  cropRelevance String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orderItems    OrderItem[]
  cartItems     CartItem[]

  @@index([isActive, category])
}

model Cart {
  id        String    @id @default(cuid())
  userId    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  qty       Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id             String    @id @default(cuid())
  orderNo        String    @unique
  userId         String
  status         String    @default("PENDING") // PENDING|CONFIRMED|PAID|SHIPPED|DELIVERED|CANCELLED
  subtotalPaisa  Int
  discountPaisa  Int       @default(0)
  deliveryFeePaisa Int     @default(0)
  totalPaisa     Int
  paymentStatus  String    @default("UNPAID") // UNPAID|PAID|REFUNDED
  shippingName   String?
  shippingPhone  String?
  shippingAddress String?
  cancelReason   String?
  clientRequestId String? // client-supplied checkout idempotency key (AUD-125)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          OrderItem[]

  // At most one order per user per client request key. NULL keys stay
  // unconstrained: sqlite and postgres both treat NULLs as distinct in
  // unique indexes, so orders without a key never collide.
  @@unique([userId, clientRequestId])
  @@index([userId])
  @@index([userId, createdAt])

  @@index([status])
  @@index([status, createdAt])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  nameSnapshot   String
  skuSnapshot    String
  unitPricePaisa Int
  qty            Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Service {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  category      String // DRONE|TRACTOR|COMBINE_HARVESTER|RICE_TRANSPLANTER|POWER_TILLER|LAND_LEVELLER|THRESHER|SOIL_TESTING|AGRONOMIST|OTHER
  basePricePaisa Int
  priceUnit     String  @default("PER_BIGHA")
  description   String?
  isActive      Boolean @default(true)
  providers     ServiceProvider[]
  bookings      Booking[]
}

model ServiceProvider {
  id          String  @id @default(cuid())
  serviceId   String
  userId      String?
  name        String
  phone       String?
  district    String?
  ratingSum   Int     @default(0)
  ratingCount Int     @default(0)
  isActive    Boolean @default(true)
  service     Service @relation(fields: [serviceId], references: [id])
  bookings    Booking[]

  @@index([serviceId])
}

model Booking {
  id                 String    @id @default(cuid())
  bookingNo          String    @unique
  userId             String
  farmId             String
  serviceId          String
  providerId         String?
  scheduledFor       DateTime
  areaBigha          Float
  estimatedPricePaisa Int
  status             String    @default("REQUESTED") // REQUESTED|ASSIGNED|IN_PROGRESS|COMPLETED|CANCELLED
  paymentStatus      String    @default("UNPAID")
  rating             Int?
  cancelReason       String?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  farm               Farm          @relation(fields: [farmId], references: [id])
  service            Service       @relation(fields: [serviceId], references: [id])
  provider           ServiceProvider? @relation(fields: [providerId], references: [id])

  @@index([userId])
  @@index([status])
}

model ProcurementOrder {
  id                   String   @id @default(cuid())
  poNo                 String   @unique
  userId               String
  farmId               String
  cropName             String
  quantityKg           Float
  moisturePct          Float?
  qualityGrade         String? // A|B|C
  basePricePerKgPaisa  Int
  deductionsPaisa      Int      @default(0)
  netPayablePaisa      Int
  status               String   @default("SUBMITTED") // SUBMITTED|QC|PURCHASE_ORDER|COLLECTED|PAID|REJECTED|CANCELLED
  notes                String?
  qcNotes              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User @relation(fields: [userId], references: [id], onDelete: Restrict)
  farm                 Farm @relation(fields: [farmId], references: [id])

  @@index([userId])
  @@index([status])
}

model Payment {
  id          String   @id @default(cuid())
  refNo       String   @unique
  userId      String
  purposeType String // ORDER|BOOKING|PROCUREMENT|MEMBERSHIP
  purposeId   String
  amountPaisa Int
  method      String   @default("MOBILE_WALLET") // MOBILE_WALLET|CARD|BANK|WALLET_CREDIT
  providerRef String?
  status      String   @default("PENDING") // PENDING|SUCCEEDED|FAILED|REFUNDED
  refundedAt  DateTime?
  refundRef   String?
  metaStr     String?
  createdAt   DateTime @default(now())
  requestId   String? // request correlation id (X-Request-Id) for support/audit joins
  updatedAt   DateTime @updatedAt
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([purposeType, purposeId])

  @@index([status, createdAt])
}

model Wallet {
  id           String @id @default(cuid())
  userId       String @unique
  balancePaisa Int    @default(0)
  // Sum of PENDING withdrawal amounts currently held against this wallet
  // (available = balancePaisa - heldPaisa). A hold is reserved at request time
  // and released by admin APPROVE (which simultaneously debits balancePaisa)
  // or REJECT. Maintenance is serialized under the wallet row's write lock
  // (see the withdraw/decision transactions).
  heldPaisa    Int    @default(0)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id             String   @id @default(cuid())
  userId         String
  direction      String // CREDIT|DEBIT
  amountPaisa    Int
  reason         String
  balanceAfterPaisa Int
  refType        String?
  refId          String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

model Withdrawal {
  id          String    @id @default(cuid())
  refNo       String    @unique
  userId      String
  amountPaisa Int
  status      String    @default("PENDING") // PENDING|APPROVED|REJECTED|PAID
  channel     String    @default("BKASH") // BKASH|NAGAD|BANK
  destination String? // masked payout destination (e.g., 017***4567)
  note        String?
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])

  @@index([status, createdAt])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  userId     String
  phone      String
  codeHash   String
  purpose    String    @default("PHONE_VERIFY")
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  sessionId String?
  propsStr  String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId, createdAt])
}

model MembershipPlan {
  id          String  @id @default(cuid())
  tier        String  @unique // BRONZE|SILVER|GOLD
  pricePaisa  Int
  durationDays Int    @default(365)
  benefitsStr String // JSON array of benefit strings; configurable from admin
  isActive    Boolean @default(true)
}

model Notification {
  id       String    @id @default(cuid())
  userId   String
  type     String // SYSTEM|ORDER|BOOKING|PROCUREMENT|PAYMENT|WEATHER|AI|MEMBERSHIP
  category String    @default("INFO") // CRITICAL|ACTION|INFO
  title    String
  body     String
  readAt   DateTime?
  refType  String?
  refId    String?
  createdAt DateTime @default(now())
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  ip         String?
  metaStr    String?
  createdAt  DateTime @default(now())
  actor      User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model AiUsageLog {
  id         String   @id @default(cuid())
  userId     String?
  provider   String
  model      String
  tokensIn   Int?
  tokensOut  Int?
  costEstimatePaisa Int?
  latencyMs  Int
  success    Boolean
  createdAt  DateTime @default(now())
  user       User? @relation(fields: [userId], references: [id])
  requestId  String?
  kbVersion  String?

  @@index([createdAt])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  type      String   // COOPERATIVE | CORPORATE | NGO | GOVT
  district  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   OrganizationMember[]
  farms     Farm[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("MEMBER") // ADMIN | MEMBER | VIEWER
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model StoredObject {
  id        String   @id @default(cuid())
  key       String   @unique // storage key returned by save(), e.g. uploads/disease/<file>
  mime      String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())
}

model PendingUploadPurge {
  id        String   @id @default(cuid())
  key       String
  context   String
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model LoginAttempt {
  phoneKey    String    @id // salted sha256 of the normalized phone — no PII at rest
  count       Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}
