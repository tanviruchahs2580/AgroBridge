{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {},
    "apps/api": {
      "entry": [
        "tests/**"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "prisma/schema.prisma",
        "prisma/postgres/**/*.prisma",
        "prisma/migrations/**",
        "scripts/**/*.mjs"
      ]
    },
    "apps/web": {
      "entry": [
        "src/**/*.test.{ts,tsx}",
        "e2e/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}"
      ]
    }
  },
  "ignoreBinaries": [
    "SELECT"
  ],
  "ignoreDependencies": [
    "@prisma/client"
  ]
}
